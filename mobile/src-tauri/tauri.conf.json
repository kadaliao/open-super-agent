{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Super Agent",
  "mainBinaryName": "OpenSuperAgent",
  "version": "../package.json",
  "identifier": "com.kadaliao.opensuperagent",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.productivity",
    "shortDescription": "Self-hosted AI teammates with their own computer",
    "copyright": "© Kada Liao, MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "HMDAVG9B8J"
    }
  }
}
