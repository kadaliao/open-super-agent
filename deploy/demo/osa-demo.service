# 演示服务器（demo.cclsp.top）：给苹果审核员和想先试试的人登录用。和正式服务共用 /opt/osa/app 的代码和虚拟环境，
# 数据、密码、配置都是自己的一份：
#   /opt/osa/demo/env（权限 600）：DEEPSEEK_API_KEY、OSA_PASSWORD、OSA_CONFIG=/opt/osa/demo/config.yaml、OSA_DATA_DIR=/opt/osa/demo/data
#   /opt/osa/demo/config.yaml：每次部署后用 deploy/demo/make-config.sh 从 config.yaml 重新生成（关掉电脑、去掉触发器、每天的 token 上限调小）
[Unit]
Description=open-super-agent demo
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/osa/app
EnvironmentFile=/opt/osa/demo/env
Environment=TZ=Asia/Shanghai PYTHONUNBUFFERED=1 HOME=/opt/osa/demo
ExecStart=/opt/osa/app/.venv/bin/uvicorn osa.server:app --host 127.0.0.1 --port 8766 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
MemoryMax=400M

[Install]
WantedBy=multi-user.target
