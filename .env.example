# 复制成 .env 或写进你的 shell 配置。不要提交真实的值。
DEEPSEEK_API_KEY=          # 必需（默认配置）
OSA_PASSWORD=              # 登录密码；部署到公网或多人能访问的网络时必须设置，不设置则不用登录
INSTABOX_API_KEY=          # 可选：电脑改用 Instabox 云主机
OSA_WEBHOOK_TOKEN=         # 可选：webhook 鉴权
OSA_VAULT_KEY=             # 可选：保险库主密钥；不设置时自动生成 data/vault.key
# HTTPS_PROXY=             # 可选：服务器在国内、要接 Telegram 时设置代理
# OSA_CONFIG=config.yaml   # 可选：配置文件路径
